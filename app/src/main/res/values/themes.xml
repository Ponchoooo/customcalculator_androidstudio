<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.Customcalculatorandroidstudio" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="CalcButton.Base" parent="Widget.Material3.Button">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">56dp</item>
        <item name="android:layout_columnWeight">1</item>
        <item name="android:layout_rowWeight">1</item>

        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">18sp</item>
        <item name="cornerRadius">14dp</item>
    </style>

    <style name="CalcButton.Number" parent="CalcButton.Base">
        <item name="android:backgroundTint">@color/btnNumberBg</item>
        <item name="android:textColor">@color/btnNumberText</item>
    </style>

    <style name="CalcButton.Operator" parent="CalcButton.Base">
        <item name="android:backgroundTint">@color/btnOperatorBg</item>
        <item name="android:textColor">@color/btnOperatorText</item>
    </style>

    <style name="CalcButton.Secondary" parent="CalcButton.Base">
        <item name="android:backgroundTint">@color/btnSecondaryBg</item>
        <item name="android:textColor">@color/btnSecondaryText</item>
    </style>

    <style name="CalcButton.Accent" parent="CalcButton.Base">
        <item name="android:backgroundTint">@color/btnAccentBg</item>
        <item name="android:textColor">@color/btnAccentText</item>
    </style>
</resources>